# Copy to .env and fill in. Never commit .env (doc 02 section 7).
GEMINI_API_KEY=

# LLM model selection (never hard-coded)
GEMINI_MODEL=gemini-2.0-flash

# Copilot mode in {auto, llm, fallback}:
# - auto: uses Gemini if GEMINI_API_KEY is present, else falls back
# - llm: strictly requires Gemini API
# - fallback: never calls network; routes through deterministic rules/templates
COPILOT_MODE=auto

# Timeout in seconds (default 6s per PRD / System Design)
LLM_TIMEOUT_S=6

# Domain thresholds (PRD section 4)
OVERDUE_DAYS=45

